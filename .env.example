APP_NAME=SupplyGuard
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=supplyguard
POSTGRES_URL=postgresql+asyncpg://supplyguard:supplyguard@localhost:5432/supplyguard

REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=supplyguard_chunks
QDRANT_TIMEOUT_SECONDS=60

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplyguard

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=supplyguard
MINIO_SECRET_KEY=supplyguard123
MINIO_BUCKET=supplyguard-docs
MINIO_SECURE=false

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=supplyguard-dev

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=deepseek-chat
LITELLM_API_KEY=litellm
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
LLM_FALLBACK_PROVIDER=
